{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @jobuki/web-app build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @jobuki/web-app start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
