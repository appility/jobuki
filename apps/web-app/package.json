{
  "name": "@jobuki/web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "react-router build",
    "dev": "sh -c 'react-router build --watch & node --env-file-if-exists .env --env-file-if-exists .env.local --watch server.js'",
    "build": "react-router build",
    "start": "node --env-file-if-exists .env --env-file-if-exists .env.local server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "ingest:dry-run": "node --env-file-if-exists .env --env-file-if-exists .env.local ./scripts/ingest-dry-run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@clerk/react-router": "^3.3.2",
    "@jobuki/db": "workspace:*",
    "@jobuki/types": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@react-router/express": "^7.0.0",
    "@react-router/node": "^7.0.0",
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "isbot": "^5.1.0",
    "marked": "^13.0.3",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.2"
  }
}
