{
  "name": "@jobuki/web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "react-router build",
    "dev": "sh -c 'react-router build --watch & node --env-file-if-exists .env --env-file-if-exists .env.local --watch server.js'",
    "build": "react-router build",
    "start": "node --env-file-if-exists .env --env-file-if-exists .env.local server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "ingest:dry-run": "node --env-file-if-exists .env --env-file-if-exists .env.local ./scripts/ingest-dry-run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:public": "playwright test --project=unauthenticated"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@clerk/react-router": "^3.3.2",
    "@jobuki/db": "workspace:*",
    "@jobuki/types": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@react-router/express": "^7.0.0",
    "@react-router/node": "^7.0.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/html": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "bad-words": "^4.0.0",
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "isbot": "^5.1.0",
    "isomorphic-dompurify": "^3.16.0",
    "lucide-react": "^1.18.0",
    "mammoth": "^1.12.0",
    "marked": "^13.0.3",
    "morgan": "^1.10.0",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.0.0",
    "resend": "^4.7.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bad-words": "^3.0.3",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
