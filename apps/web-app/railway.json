{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm build"
  },
  "deploy": {
    "startCommand": "sh -c 'node apps/web-app/server.js || node server.js'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
