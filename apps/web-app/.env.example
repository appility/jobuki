# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Clerk auth
# VITE_ prefix required so the publishable key is available in the browser bundle
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# App
ROOT_PROTOCOL=https
ROOT_DOMAIN=jobuki.co
NODE_ENV=production
PORT=3000

# Railway API — for automatic custom domain provisioning
# RAILWAY_TOKEN: Account Settings → Tokens in Railway dashboard
# RAILWAY_SERVICE_ID + RAILWAY_ENVIRONMENT_ID: visible in Railway dashboard URL when viewing your service
# RAILWAY_PUBLIC_URL: your Railway-assigned URL shown to board owners for their CNAME record
RAILWAY_TOKEN=your_railway_api_token
RAILWAY_SERVICE_ID=your_service_id
RAILWAY_ENVIRONMENT_ID=your_environment_id
RAILWAY_PUBLIC_URL=jobuki-production.up.railway.app
